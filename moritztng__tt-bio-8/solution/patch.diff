+import os, sys, pickle
+os.environ.setdefault('TT_LOGGER_LEVEL', 'FATAL')
+os.environ['TT_PROTENIX_DBG_COND'] = '1'; os.environ['TT_PROTENIX_NOBATCH'] = '1'

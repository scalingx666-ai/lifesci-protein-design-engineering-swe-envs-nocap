+                cmd.append("--verbose")
+            if not plots_on:
+                cmd.append("--no-plots")
+            if not animations_on:
+                cmd.append("--no-animations")
+
+            print("\nLaunching Docker:")
+            print(" ".join(cmd))
+            # Execute
+            subprocess.run(cmd)

+            # print(f"x = {x}")
+            # print(f"y = {y}")
+            # print(f"mutated_indices = {mutated_indices}")
+
+            # We use the following identity to speed things up:
+            # log P(y | x, t) = log P(x | x, t) + \sum_{i: x_i != y_i} log P(y_i | x_i, t)/P(x_i | x_i, t)

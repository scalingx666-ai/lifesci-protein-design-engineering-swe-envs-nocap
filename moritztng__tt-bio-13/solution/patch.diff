+    _CAPTURE_PATH = worker_capture_path(os.getpid())
+    cap_fd = os.open(str(_CAPTURE_PATH), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    os.dup2(cap_fd, 2)
+    os.close(cap_fd)
+    sys.stdout = open(os.devnull, "w")
+    sys.stderr = os.fdopen(2, "w", buffering=1, closefd=False)
+
+

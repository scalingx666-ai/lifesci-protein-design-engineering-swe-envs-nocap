+                    )
+                )
+            with open(filename, "rb") as f:
+                pdbstring = xz.decompress(f.read()).decode()
+        return pose_from_pdbstring(pdbstring)
+    else:
+        return rosetta.core.import_pose.pose_from_file(*args, **kwargs)

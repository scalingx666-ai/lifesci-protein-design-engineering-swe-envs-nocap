+                kwargs["PyRosettaCluster_task"].get("parameter", None),
+                GeneratorTest._parameters[1],
+                msg="Output kwargs do not have the correct value for the 'parameter' task key."
+            )
+        for _parameter in GeneratorTest._parameters:

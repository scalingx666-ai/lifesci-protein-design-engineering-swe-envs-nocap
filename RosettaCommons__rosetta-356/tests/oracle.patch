+FileType
+filetype_from_extension(
+	std::string const & filename
+) {
+	utility::vector1< std::string > split = utility::string_split( filename, '.');
+
+	std::string ext = split[split.size()-1];
+	if ( ext == "gz" ) {
+		ext = split[split.size()-2];
+	}
+	ext = utility::lower(ext);
+
+	if ( ext == "pdb" ) {
+		return PDB_file;
+	} else if ( ext == "cif" ) {
+		return CIF_file;
+	} else if ( ext == "mmcif" ) {
+		return CIF_file;
+	} else if ( ext == "mmtf" ) {
+		return MMTF_file;
+	} else if ( ext == "srlz" ) {
+		return SRLZ_file;
+	} else {
+		return Unknown_file;
+	}
+}
